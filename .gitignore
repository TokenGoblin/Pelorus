/artifacts/
*.profraw

# Editor and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
target/auditable/

# Compat suite: recorded traffic archives and the id -> url mapping are NOT
# committed to this public repository. They contain every hostname they replay,
# which is the disclosure opaque ids exist to avoid. See
# docs/adr/002-public-repository.md.
/tests/compat/archives/
/tests/compat/mapping*.toml

# Fuzzing: reproducers are transient, the corpus is not. ADR 006 requires a
# crash's input to be committed to corpus/ so the 60s smoke job catches its
# regression instead of waiting for the next 24h campaign.
/fuzz/artifacts/
/fuzz/target/
/fuzz/Cargo.lock
